# Copie este arquivo para .env.local e preencha com os IDs reais.
# .env.local nunca é commitado (já está no .gitignore).
#
# Sem esses IDs preenchidos, o Google Analytics e o Meta Pixel simplesmente não
# carregam — o site funciona normalmente sem eles.

# Google Analytics 4 — formato G-XXXXXXXXXX (encontrado em Admin > Fluxos de dados)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook/Instagram) Pixel — só o número do ID
# (encontrado no Gerenciador de Eventos do Meta Business Suite)
NEXT_PUBLIC_META_PIXEL_ID=
